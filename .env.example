# ==========================================
# GitHub Discovery - Environment Configuration
# ==========================================

# 1. GitHub API Authentication (Optional for higher rate limits)
# Built-in GITHUB_TOKEN is used in GitHub Actions automatically.
# Add a fine-grained token with NO scopes for 5,000 req/hr locally or in CI.
GITHUB_TOKEN=
GH_API_TOKEN=

# 2. Window Planning & Discovery Tuning
DISCOVERY_QUERY_FILTERS=fork:false
SEARCH_LAG_MINUTES=3
OVERLAP_MINUTES=10
RUN_TIME_BUDGET_SECONDS=480
MAX_REQUESTS_PER_RUN=50

# 3. Storage & Retention Policies
DATA_DIR=./data
RETENTION_DAYS=14
MAX_REPOS_PER_SHARD=5000

# 4. Secondary Method: Public Repositories Scan (GET /repositories?since={id})
ENABLE_PUBLIC_REPOS_SCAN=false
ENRICH_PER_RUN=10

# 5. Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MAX_PER_RUN=10
NOTIFY_MIN_STARS=0
NOTIFY_LANGUAGES=
NOTIFY_KEYWORDS=
DIGEST_FREQUENCY=daily # hourly | 6hourly | daily

# 6. Email Notifications via Resend (Optional)
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=onboarding@resend.dev

# 7. Frontend Public Data Base URL (Vite Web App)
# Local development defaults to /data automatically.
# Production on Vercel should point to your GitHub data branch raw URL:
# e.g., https://raw.githubusercontent.com/<username>/<repo>/data
VITE_DATA_BASE_URL=/data
